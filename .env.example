# =============================================================================
# Universal Booking — configuration. Copy to `.env` and fill in the values.
# Every variable maps to app/config.py (case-insensitive).
# =============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=fr
DEFAULT_TIMEZONE=Europe/Paris
HOLIDAY_COUNTRY=FR

# --- Database / cache ----------------------------------------------------------
# Local run: postgresql+asyncpg://ub:ub@localhost:5432/universal_booking
# docker-compose overrides DATABASE_URL / REDIS_URL automatically.
DATABASE_URL=postgresql+asyncpg://ub:ub@localhost:5432/universal_booking
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=ub
POSTGRES_PASSWORD=ub
POSTGRES_DB=universal_booking
SEED_FLAGS=--demo                  # empty in production (no demo data)

# --- Security ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Web admin account created by `python -m scripts.seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
RATE_LIMIT_PER_MINUTE=30

# --- Telegram ------------------------------------------------------------------
# 1. Talk to @BotFather -> /newbot -> copy the token below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=             # without @, used for share links
# Leave empty for long polling (python -m bot.main). In production set the
# public HTTPS base URL of the API: the webhook is registered at startup.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Public HTTPS URL of the Mini App (web/), e.g. https://app.example.com
WEBAPP_URL=
# Telegram user ids granted admin rights in the bot, e.g. [123456789]
ADMIN_TELEGRAM_IDS=[]

# --- Artificial intelligence -----------------------------------------------------
# Optional. Without a key the deterministic French/English NLU is used.
# Get a key at https://console.anthropic.com
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_TIMEOUT_SECONDS=20

# --- Geocoding ----------------------------------------------------------------------
GEOCODER=local                     # local (bundled French cities) | nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=universal-booking/1.0
AVERAGE_TRAVEL_SPEED_KMH=30

# --- Business rules -------------------------------------------------------------------
AUTO_APPROVE_PROFESSIONALS=false   # true = new pros visible without admin validation
PENDING_BOOKING_TIMEOUT_HOURS=24
QUOTE_REQUEST_MAX_RECIPIENTS=15
QUOTE_REQUEST_TTL_DAYS=14
PAYMENTS_ENABLED=false
